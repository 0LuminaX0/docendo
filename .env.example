# Copy to .env for local use. On Vercel, add these under Project → Settings → Environment Variables.
# Nothing here is ever sent to the browser.

# OpenRouter key. Without it the app runs in demo mode (Kai uses scripted replies).
# In OpenRouter, give this key a credit limit (e.g. $5) so a leak or abuse can never cost more.
OPENROUTER_API_KEY=

# Signs session tokens. Required on Vercel. Make one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: one shared code for the team, TAs and demos (sessions get the direct condition).
ACCESS_CODE=

# For the study: participant codes. Each participant gets their own code (pnpm codes 40), and the
# code itself decides their condition (direct or recursive), in balanced blocks of 4. Keep this
# secret and the same everywhere: changing it invalidates every code handed out. openssl rand -hex 24
CODE_SECRET=

# Practice chapter: minutes (overrides practice.json) and checks per problem (a first try and one retry).
PRACTICE_MINUTES=
PRACTICE_TRIES=2
# How long a session (and its progress on the device) lasts, in days.
SESSION_DAYS=10
# The delayed test: it opens this many days after a participant's final test, with the other test form, when they
# come back with the same one-time code (or on the same device). Leave empty for no delayed test.
DELAYED_TEST_DAYS=

# The admin panel (/admin): research dashboard, sessions, access codes, feedback. Off without a password
# (10+ characters). With it set, the start page asks everyone for a code (made in the panel, or the shared one).
ADMIN_PASSWORD=

# REQUIRED for the study: the research log (every chat turn, click, video event, practice try and
# test answer) is stored here; without it, on Vercel the data only lands in short-lived function logs.
# Also shares rate-limit counters between server instances.
# Vercel → Storage → Marketplace → Upstash Redis (free tier) fills these in for you.
# Export with `pnpm events export` (put the same two values in your local .env).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional caps (defaults shown)
# DAILY_TURN_LIMIT=1500        # chat turns per day for the whole site (≈ 3,000–4,500 model calls)
# SESSION_TURN_LIMIT=45        # chat turns per learner session (Kai wraps up at 30)
# SESSION_TURNS_PER_MIN=10     # one learner's burst
# IP_TURNS_PER_MIN=120         # one network; a lab room shares one IP
# IP_SESSIONS_PER_HOUR=60      # new sessions per network per hour

# Optional model overrides (OpenRouter ids)
# DOCENDO_MODEL_JUDGE=google/gemini-3.5-flash-lite      (pnpm eval:judge)
# DOCENDO_MODEL_WRITER=google/gemini-3.5-flash-lite     (pnpm eval:chat)
# Kai solving practice problems (recursive feedback); chosen with pnpm eval:solver
# DOCENDO_MODEL_SOLVER=anthropic/claude-haiku-5.5
# DOCENDO_MODEL_TRANSCRIBE=google/gemini-3.1-flash-lite   # voice input (speech to text); mistralai/voxtral-small-24b-2507 is more accurate on hard audio, five times the price
# Which provider OpenRouter tries first. "latency" (default here) took judge calls from ~13 s to ~1 s.
# DOCENDO_PROVIDER_SORT=latency
# DOCENDO_DEMO=1               # force demo mode even with a key
